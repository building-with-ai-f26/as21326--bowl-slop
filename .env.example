# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Used only by server.js (the AI game-over coach, calls Claude Haiku). Never put this in browser code.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# Optional: which model writes the coach line (default claude-haiku-5-5)
# COACH_MODEL=claude-haiku-5-5
